# =====================================================================
# Don Repuestos Jaimes — variables de entorno del backend
# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
# =====================================================================
NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL: postgres://usuario:contraseña@host:puerto/base
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/drj

# Secreto para firmar sesiones del panel (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA_EN=8h

# Orígenes permitidos (frontend), separados por coma
CORS_ORIGENES=http://localhost:5173

# Si el backend está detrás de un proxy (Nginx, Render, Railway), número de saltos de proxy
CONFIAR_PROXY=0

# ---- Integración con n8n (opcional) ----
# Secreto compartido para firmar webhooks en ambos sentidos (mínimo 32 caracteres)
WEBHOOK_SECRET=
# Webhook de n8n que avisa a un asesor cuando el asistente escala una conversación
N8N_NOTIFICACION_URL=
# Webhook de n8n que entrega mensajes del asesor al cliente en WhatsApp/Telegram
N8N_SALIENTE_URL=

# ---- Límites de solicitudes ----
RATE_LIMIT_CHAT_POR_MINUTO=30
RATE_LIMIT_LOGIN_POR_15MIN=10

# ---- Solo para el script crear-admin (no los dejes en el .env de producción) ----
# ADMIN_NOMBRE=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
