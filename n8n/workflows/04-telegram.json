      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Telegram envía X-Telegram-Bot-Api-Secret-Token si se configuró secret_token en setWebhook\nconst h = $json.headers || {};\nif (h['x-telegram-bot-api-secret-token'] !== $env.TELEGRAM_WEBHOOK_SECRET) throw new Error('Secreto de Telegram inválido');\nconst m = ($json.body || {}).message;\nif (!m || !m.text) return [];\nconst texto = m.text === '/start' ? 'hola' : m.text;\nreturn [{ json: { chat: m.chat.id, payload: { canal: 'telegram', canal_usuario_id: String(m.chat.id), texto } } }];"
      }
    },
    {
      "id": "82b3cefe-c0b2-50c4-8fe0-0eb30570dc1b",
      "name": "Firmar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Firma HMAC-SHA256: firma = HMAC(DRJ_WEBHOOK_SECRET, `${ts}.${cuerpo}`)\n// Requiere NODE_FUNCTION_ALLOW_BUILTIN=crypto en el entorno de n8n.\nconst crypto = require('crypto');\nconst secreto = $env.DRJ_WEBHOOK_SECRET;\nif (!secreto) throw new Error('Falta la variable DRJ_WEBHOOK_SECRET en n8n');\nreturn items.map((item) => {\n  const cuerpo = JSON.stringify(item.json.payload);\n  const ts = Math.floor(Date.now() / 1000).toString();\n  const firma = crypto.createHmac('sha256', secreto).update(`${ts}.${cuerpo}`).digest('hex');\n  return { json: { ...item.json, cuerpo, ts, firma } };\n});"
      }
    },
    {
      "id": "46f5706b-d39f-5f67-90d1-065bcbe507bd",
      "name": "Asistente (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DRJ_API_URL }}/api/integraciones/mensaje",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-drj-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-drj-firma",
              "value": "={{ $json.firma }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.cuerpo }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "f99eeca2-c3aa-5052-8839-179795b5e956",
      "name": "¿Hay respuesta?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const chat = $('Firmar').item.json.chat;\nconst t = ($json.data && $json.data.texto_respuesta) || '';\nreturn t ? [{ json: { chat, texto: t.slice(0, 4096) } }] : [];"
      }
    },
    {
      "id": "487b0654-6479-5f4f-a08e-1933cc1dba2f",
