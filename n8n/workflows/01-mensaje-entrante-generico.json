        "path": "drj/mensaje",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "c4a21013-f6b4-5458-a9ae-1f87483cb32c"
    },
    {
      "id": "638e2559-bd02-57fa-a196-035a418a3a2a",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Entrada esperada: { \"canal\": \"whatsapp\"|\"telegram\"|\"otro\", \"canal_usuario_id\": \"...\", \"texto\": \"...\" }\nconst b = $json.body || {};\nconst canal = ['whatsapp', 'telegram', 'otro'].includes(b.canal) ? b.canal : 'otro';\nconst usuario = String(b.canal_usuario_id || '').slice(0, 120);\nconst texto = String(b.texto || '').slice(0, 1000);\nif (!usuario || !texto) throw new Error('Faltan canal_usuario_id o texto');\nreturn [{ json: { payload: { canal, canal_usuario_id: usuario, texto } } }];"
      }
    },
    {
      "id": "82b3cefe-c0b2-50c4-8fe0-0eb30570dc1b",
      "name": "Firmar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        330,
        0
      ],
      "parameters": {
        "jsCode": "// Firma HMAC-SHA256: firma = HMAC(DRJ_WEBHOOK_SECRET, `${ts}.${cuerpo}`)\n// Requiere NODE_FUNCTION_ALLOW_BUILTIN=crypto en el entorno de n8n.\nconst crypto = require('crypto');\nconst secreto = $env.DRJ_WEBHOOK_SECRET;\nif (!secreto) throw new Error('Falta la variable DRJ_WEBHOOK_SECRET en n8n');\nreturn items.map((item) => {\n  const cuerpo = JSON.stringify(item.json.payload);\n  const ts = Math.floor(Date.now() / 1000).toString();\n  const firma = crypto.createHmac('sha256', secreto).update(`${ts}.${cuerpo}`).digest('hex');\n  return { json: { ...item.json, cuerpo, ts, firma } };\n});"
      }
    },
    {
      "id": "46f5706b-d39f-5f67-90d1-065bcbe507bd",
      "name": "Asistente (backend)",
      "type": "n8n-nodes-base.httpRequest",
